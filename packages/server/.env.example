# packages/server/.env로 복사해서 실제 값 채우기 (.env는 .gitignore 처리됨 — 커밋 금지)

# 코어 AI 페르소나가 어느 경로로 Claude를 호출할지는 수동 토글이 아니라 아래 두 키 중
# 어느 쪽이 채워졌는지로 자동 결정된다(activePersonaProvider 참고) — 둘 다 채우면
# direct가 우선한다. 토글이 실제 채운 키와 어긋나 조용히 폴백만 나가는 사고를 막기 위해서다.

# --- direct (Anthropic API 바로 호출) ---
# 일반 ANTHROPIC_API_KEY가 아니다 — Claude Code 등 다른 도구가 이미 그 이름을 셸에
# 등록해 놓은 경우가 흔해서, 겹치지 않게 이 기능 전용 이름을 쓴다.
CORE_PERSONA_ANTHROPIC_API_KEY=
CORE_PERSONA_MODEL=claude-haiku-4-5

# --- hchat (사내 게이트웨이 경유, CORE_PERSONA_ANTHROPIC_API_KEY가 비어 있을 때만 씀) ---
H_CHAT_API_KEY=
H_CHAT_API_MODEL=
# Personal API 키면 비워두고, Project API 키면 채운다.
H_CHAT_API_PROJECT_ID=

# 개발 모드(치트/dev 콘솔) 켜기. 로컬 개발 중엔 보통 1로 둔다.
DROPFALL_DEV=1
